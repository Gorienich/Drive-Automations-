// ============================================================
// INSTALLATIONS AUTOMATION — SIMPLE PRODUCTION VERSION
// ============================================================

const CONFIG = {
  // Main workspace spreadsheet where daily work is managed d/<<THIS PART>>/edit
  WORKSPACE_SPREADSHEET_ID: '<<THIS PART>>',

  // Active worksheet/tab name inside the workspace spreadsheet
  WORKSPACE_SHEET_NAME: 'IYOUR SPREADSHEET NAME',

  // Audit log worksheet/tab name inside the workspace spreadsheet
  AUDIT_SHEET_NAME: 'Audit Log',

  // Root Google Drive folder where year/month archive folders are stored https://drive.google.com/drive/folders/<<THIS PART>>
  ROOT_FOLDER_ID: '<<THIS PART>>',

// Email recipients used for critical errors
ERROR_EMAILS: [
  'director@company.com',
  'developer@company.com'
],

  // Number of fresh template rows to create after each daily archive
  READY_ROWS_COUNT: 10,

  // Script timezone. Apps Script project timezone must match this value
  TIMEZONE: 'Asia/Jerusalem',

  // Default placeholder values used in new workspace rows
  STATUS_PLACEHOLDER: 'סטאטוס',
  TIME_PLACEHOLDER: 'זמן',
  NAME_PLACEHOLDER: 'שם',

  // Zero-based column indexes used by the script
  COL_DATE: 0,    // Column A — installation date
  COL_DAY: 1,     // Column B — Hebrew day name
  COL_ID: 2,      // Column C — customer/order ID
  COL_STATUS: 3,  // Column D — installation status
  COL_TIME: 4,    // Column E — installation time slot
  COL_NAME: 5,    // Column F — manager/agent name
  COL_MID: 6,     // Column G — MID/reference field

  // Hebrew day names by JavaScript day index: Sunday = 0, Saturday = 6
  HEBREW_DAYS: ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שבת'],

  // Final valid statuses used for archived records
  VALID_STATUSES: ['תואם', 'לא תואם', 'בוטל']
};


// ============================================================
// SETUP
// ============================================================

function validateConfig() {
  const errors = [];

  try {
    const file = DriveApp.getFileById(CONFIG.WORKSPACE_SPREADSHEET_ID);
    if (file.getMimeType() !== MimeType.GOOGLE_SHEETS) {
      errors.push('Workspace file is not native Google Sheets');
    }

    const ss = SpreadsheetApp.openById(CONFIG.WORKSPACE_SPREADSHEET_ID);
    if (!ss.getSheetByName(CONFIG.WORKSPACE_SHEET_NAME)) {
      errors.push(`Workspace tab not found: ${CONFIG.WORKSPACE_SHEET_NAME}`);
    }
  } catch (e) {
    errors.push(`Cannot open workspace: ${e.message}`);
  }

  try {
    DriveApp.getFolderById(CONFIG.ROOT_FOLDER_ID);
  } catch (e) {
    errors.push(`Cannot access root folder: ${e.message}`);
  }

  if (Session.getScriptTimeZone() !== CONFIG.TIMEZONE) {
    errors.push(`Project timezone must be ${CONFIG.TIMEZONE}`);
  }

  if (errors.length > 0) {
    throw new Error(errors.join('\n'));
  }

  Logger.log('✅ Config valid');
}


function setupTriggers() {
  validateConfig();

  ScriptApp.getProjectTriggers().forEach(t => ScriptApp.deleteTrigger(t));

  ScriptApp.newTrigger('dailyEndOfDay')
    .timeBased()
    .atHour(21)
    .everyDays(1)
    .create();

  Logger.log('✅ Daily trigger created for 21:00');
}


// ============================================================
// MAIN DAILY FLOW
// ============================================================

function dailyEndOfDay() {
  const lock = LockService.getScriptLock();
  const now = new Date();
  const runId = Utilities.getUuid().slice(0, 8).toUpperCase();
  const audit = [];
  let tempSheet = null;

  try {
    lock.waitLock(30000);

    validateConfig();

    const ss = SpreadsheetApp.openById(CONFIG.WORKSPACE_SPREADSHEET_ID);
    const ws = ss.getSheetByName(CONFIG.WORKSPACE_SHEET_NAME);

    tempSheet = backupTemplateRow(ss, ws);

    const archiveResult = archiveWorkspaceRows(now, audit);

    resetWorkspaceFromTemplate(ws, tempSheet, now);

    audit.push({
      step: 'Reset Workspace',
      status: 'OK',
      details: `Created ${CONFIG.READY_ROWS_COUNT} fresh rows`
    });

    ensureMonthlyFilesExist(now, audit);

    if (now.getMonth() === 11 && now.getDate() === 31) {
      prepareYear(now.getFullYear() + 1, audit);
    }

    writeAuditLog(now, runId, 'SUCCESS', audit);

  } catch (err) {
    audit.push({
      step: 'CRITICAL ERROR',
      status: 'ERROR',
      details: err.message
    });

    writeAuditLog(now, runId, 'ERROR', audit);

    sendErrorAlert(
      `⚠️ שגיאה באוטומציית התקנות [${runId}]`,
      buildErrorBody(now, runId, err, audit)
    );

    throw err;

  } finally {
    try {
      if (tempSheet) tempSheet.getParent().deleteSheet(tempSheet);
    } catch (e) {}

    try {
      lock.releaseLock();
    } catch (e) {}
  }
}


// ============================================================
// ARCHIVE WORKSPACE ROWS
// ============================================================

function archiveWorkspaceRows(archiveTime, audit) {
  const ss = SpreadsheetApp.openById(CONFIG.WORKSPACE_SPREADSHEET_ID);
  const ws = ss.getSheetByName(CONFIG.WORKSPACE_SHEET_NAME);

  const values = ws.getDataRange().getValues();
  const display = ws.getDataRange().getDisplayValues();

  const grouped = {};
  const rowsToDelete = [];

  for (let i = 1; i < values.length; i++) {
    const row = values[i];
    const displayRow = display[i];

    if (isEmptyRow(row)) continue;

    const installDate = parseDate(displayRow[CONFIG.COL_DATE]);
    if (!installDate) continue;

    if (!hasRealData(row)) continue;

    row[CONFIG.COL_DATE] = installDate;
    normalizeRowStatus(row);

    const key = `${installDate.getFullYear()}_${installDate.getMonth() + 1}`;

    if (!grouped[key]) grouped[key] = [];

    grouped[key].push({
      row,
      sheetRow: i + 1
    });
  }

  let total = 0;

  Object.keys(grouped).forEach(key => {
    const [year, month] = key.split('_').map(Number);
    const batch = grouped[key];

    const inserted = appendRowsToMonthlySheet(
      year,
      month,
      batch.map(x => x.row),
      archiveTime
    );

    if (inserted !== batch.length) {
      throw new Error(`Archive mismatch for ${year}_${month}: expected ${batch.length}, inserted ${inserted}`);
    }

    total += inserted;

    batch.forEach(x => rowsToDelete.push(x.sheetRow));

    audit.push({
      step: 'Archive Rows',
      status: 'OK',
      targetFile: `${year}_${String(month).padStart(2, '0')}`,
      targetSheet: `${String(month).padStart(2, '0')}${year}`,
      received: batch.length,
      inserted: inserted
    });
  });

  rowsToDelete
    .sort((a, b) => b - a)
    .forEach(rowNum => ws.deleteRow(rowNum));

  audit.push({
    step: 'Archive Summary',
    status: 'OK',
    details: `${total} rows archived`
  });

  return total;
}


function hasRealData(row) {
  const id = clean(row[CONFIG.COL_ID]);
  const status = clean(row[CONFIG.COL_STATUS]);
  const time = clean(row[CONFIG.COL_TIME]);
  const name = clean(row[CONFIG.COL_NAME]);
  const mid = clean(row[CONFIG.COL_MID]);

  return (
    id !== '' ||
    mid !== '' ||
    (status !== '' && status !== CONFIG.STATUS_PLACEHOLDER) ||
    (time !== '' && time !== CONFIG.TIME_PLACEHOLDER) ||
    (name !== '' && name !== CONFIG.NAME_PLACEHOLDER)
  );
}


function normalizeRowStatus(row) {
  const status = clean(row[CONFIG.COL_STATUS]);

  if (status === 'רץ' || status === 'ממתין') {
    row[CONFIG.COL_STATUS] = 'לא תואם';
  }
}


// ============================================================
// MONTHLY FILES
// ============================================================

function appendRowsToMonthlySheet(year, month, rows, archiveTime) {
  if (!rows.length) return 0;

  const sheet = getOrCreateMonthlySheet(year, month);
  const archivedAt = archiveTime || new Date();

  const output = rows.map(row => [
    dayStart(row[CONFIG.COL_DATE]),
    row[CONFIG.COL_DAY],
    row[CONFIG.COL_ID],
    row[CONFIG.COL_STATUS],
    row[CONFIG.COL_TIME],
    row[CONFIG.COL_NAME],
    row[CONFIG.COL_MID],
    archivedAt
  ]);

  const startRow = sheet.getLastRow() + 1;

  sheet.getRange(startRow, 1, output.length, 8).setValues(output);
  sheet.getRange(startRow, 1, output.length, 1).setNumberFormat('dd/mm/yyyy');
  sheet.getRange(startRow, 8, output.length, 1).setNumberFormat('dd/mm/yyyy HH:mm:ss');

  SpreadsheetApp.flush();

  return output.length;
}


function getOrCreateMonthlySheet(year, month) {
  const monthStr = String(month).padStart(2, '0');
  const fileName = `${year}_${monthStr}`;
  const sheetName = `${monthStr}${year}`;

  const folder = getOrCreateYearFolder(year);
  const files = folder.getFilesByName(fileName);

  let ss;

  if (files.hasNext()) {
    ss = SpreadsheetApp.open(files.next());
  } else {
    ss = SpreadsheetApp.create(fileName);
    DriveApp.getFileById(ss.getId()).moveTo(folder);
  }

  let sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.getSheets()[0];
    sheet.setName(sheetName);
  }

  upgradeMonthlySheet(sheet);

  return sheet;
}


function upgradeMonthlySheet(sheet) {
  const headers = ['תאריך','יום','ID','סטאטוס','זמן','שם','MID','ארכיון בתאריך'];

  sheet.setRightToLeft(true);
  sheet.getRange(1, 1, 1, 8).setValues([headers]);
  sheet.setFrozenRows(1);

  sheet.getRange('A:A').setNumberFormat('dd/mm/yyyy');
  sheet.getRange('H:H').setNumberFormat('dd/mm/yyyy HH:mm:ss');

  sheet.getRange(1, 1, 1, 8)
    .setFontWeight('bold')
    .setBackground('#e8f0fe');

  sheet.autoResizeColumns(1, 8);
}


function getOrCreateYearFolder(year) {
  const root = DriveApp.getFolderById(CONFIG.ROOT_FOLDER_ID);
  const folders = root.getFoldersByName(String(year));

  return folders.hasNext() ? folders.next() : root.createFolder(String(year));
}


function ensureMonthlyFilesExist(date, audit) {
  const currentYear = date.getFullYear();
  const currentMonth = date.getMonth() + 1;

  getOrCreateMonthlySheet(currentYear, currentMonth);

  const nextMonthDate = new Date(currentYear, currentMonth, 1);
  getOrCreateMonthlySheet(nextMonthDate.getFullYear(), nextMonthDate.getMonth() + 1);

  audit.push({
    step: 'Ensure Monthly Files',
    status: 'OK',
    details: 'Current and next month files verified'
  });
}


function prepareYear(year, audit) {
  for (let m = 1; m <= 12; m++) {
    getOrCreateMonthlySheet(year, m);
  }

  audit.push({
    step: 'Prepare Year Folder',
    status: 'OK',
    details: `Year ${year} prepared`
  });
}


// ============================================================
// WORKSPACE RESET
// ============================================================

function backupTemplateRow(ss, ws) {
  const old = ss.getSheetByName('_TempTemplateSheet_');
  if (old) ss.deleteSheet(old);

  const temp = ss.insertSheet('_TempTemplateSheet_');
  temp.hideSheet();

  ws.getRange(2, 1, 1, 7).copyTo(temp.getRange(1, 1, 1, 7));

  return temp;
}


function resetWorkspaceFromTemplate(ws, tempSheet, baseDate) {
  const nextDay = getNextWorkingDay(baseDate);
  const hebrewDay = CONFIG.HEBREW_DAYS[nextDay.getDay()];

  ws.insertRowsBefore(2, CONFIG.READY_ROWS_COUNT);

  const source = tempSheet.getRange(1, 1, 1, 7);
  const target = ws.getRange(2, 1, CONFIG.READY_ROWS_COUNT, 7);

  source.copyTo(target);

  const formulas = target.getFormulas();
  const values = [];

  for (let r = 0; r < CONFIG.READY_ROWS_COUNT; r++) {
    const row = [];

    for (let c = 0; c < 7; c++) {
      if (formulas[r][c]) {
        row.push(formulas[r][c]);
      } else if (c === CONFIG.COL_DATE) {
        row.push(nextDay);
      } else if (c === CONFIG.COL_DAY) {
        row.push(hebrewDay);
      } else if (c === CONFIG.COL_ID || c === CONFIG.COL_MID) {
        row.push('');
      } else if (c === CONFIG.COL_STATUS) {
        row.push(CONFIG.STATUS_PLACEHOLDER);
      } else if (c === CONFIG.COL_TIME) {
        row.push(CONFIG.TIME_PLACEHOLDER);
      } else if (c === CONFIG.COL_NAME) {
        row.push(CONFIG.NAME_PLACEHOLDER);
      } else {
        row.push('');
      }
    }

    values.push(row);
  }

  target.setValues(values);
  ws.getRange(2, 1, CONFIG.READY_ROWS_COUNT, 1).setNumberFormat('dd/mm/yyyy');
}


function getNextWorkingDay(date) {
  const d = new Date(date.getTime());
  d.setDate(d.getDate() + 1);
  d.setHours(0, 0, 0, 0);

  while (d.getDay() === 6) {
    d.setDate(d.getDate() + 1);
  }

  return d;
}


// ============================================================
// AUDIT + ERROR EMAIL
// ============================================================

function writeAuditLog(date, runId, status, steps) {
  try {
    const ss = SpreadsheetApp.openById(CONFIG.WORKSPACE_SPREADSHEET_ID);
    let sheet = ss.getSheetByName(CONFIG.AUDIT_SHEET_NAME);

    if (!sheet) {
      sheet = ss.insertSheet(CONFIG.AUDIT_SHEET_NAME);
      sheet.setRightToLeft(true);
      sheet.appendRow([
        'תאריך','שעה','Run ID','סטטוס','שלב',
        'קובץ יעד','גיליון יעד','התקבלו','הוכנסו','פרטים'
      ]);
      sheet.setFrozenRows(1);
    }

    const d = date instanceof Date ? date : new Date();
    const dateStr = formatDate(d);
    const timeStr = Utilities.formatDate(d, CONFIG.TIMEZONE, 'HH:mm:ss');

    steps.forEach(s => {
      sheet.appendRow([
        dateStr,
        timeStr,
        runId,
        s.status || status,
        s.step || '',
        s.targetFile || '',
        s.targetSheet || '',
        s.received || '',
        s.inserted || '',
        s.details || ''
      ]);
    });

  } catch (e) {
    Logger.log('Audit failed: ' + e.message);
  }
}


function sendErrorAlert(subject, body) {
  try {
    MailApp.sendEmail(CONFIG.ERROR_EMAIL, subject, body);
  } catch (e) {
    Logger.log('Could not send error email: ' + e.message);
  }
}


function buildErrorBody(date, runId, err, audit) {
  return [
    `Run ID: ${runId}`,
    `Date: ${formatDate(date)} ${Utilities.formatDate(date, CONFIG.TIMEZONE, 'HH:mm:ss')}`,
    '',
    `Error: ${err.message}`,
    '',
    'Stack:',
    err.stack || '',
    '',
    'Audit:',
    JSON.stringify(audit, null, 2)
  ].join('\n');
}


// ============================================================
// UTILS
// ============================================================

function parseDate(value) {
  if (!value) return null;

  if (value instanceof Date && !isNaN(value.getTime())) {
    return dayStart(value);
  }

  const text = String(value).trim();
  if (!text) return null;

  const datePart = text.split(/\s+/)[0];
  const match = datePart.match(/^(\d{1,2})[\/\.\-](\d{1,2})[\/\.\-](\d{4})$/);

  if (!match) return null;

  const day = Number(match[1]);
  const month = Number(match[2]);
  const year = Number(match[3]);

  const d = new Date(year, month - 1, day);

  if (d.getFullYear() !== year || d.getMonth() !== month - 1 || d.getDate() !== day) {
    return null;
  }

  return dayStart(d);
}


function dayStart(date) {
  const d = new Date(date.getTime());
  d.setHours(0, 0, 0, 0);
  return d;
}


function formatDate(date) {
  const d = date instanceof Date ? date : new Date();

  return [
    String(d.getDate()).padStart(2, '0'),
    String(d.getMonth() + 1).padStart(2, '0'),
    d.getFullYear()
  ].join('/');
}


function clean(value) {
  return String(value || '').trim();
}


function isEmptyRow(row) {
  return row.every(cell => clean(cell) === '');
}


