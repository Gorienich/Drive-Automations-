<html dir="rtl" lang="he">
<head><meta charset="UTF-8"></head>
<body style="font-family:Arial,sans-serif;background:#f5f5f5;margin:0;padding:20px;direction:rtl;">
  <div style="max-width:620px;margin:0 auto;background:white;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">

    <!-- Header -->
    <div style="background:linear-gradient(135deg,#1a73e8,#0d47a1);color:white;padding:28px 24px;">
      <h1 style="margin:0;font-size:22px;font-weight:700;">📊 דוח ${periodLabel} — ניהול התקנות</h1>
      <p style="margin:6px 0 0;opacity:0.85;font-size:14px;">${formatDate(startDate)} – ${formatDate(endDate)}</p>
    </div>

    <!-- Total -->
    <div style="padding:24px;text-align:center;border-bottom:1px solid #f0f0f0;">
      <div style="display:inline-block;background:#e8f0fe;border-radius:12px;padding:16px 32px;">
        <div style="font-size:52px;font-weight:800;color:#1a73e8;line-height:1;">${stats.total}</div>
        <div style="color:#555;font-size:15px;margin-top:4px;">סה"כ התקנות בתקופה</div>
      </div>
    </div>

    <div style="padding:20px 24px;">

      <!-- By Status -->
      <h2 style="color:#1a73e8;font-size:16px;border-right:4px solid #1a73e8;padding-right:10px;margin:0 0 12px;">לפי סטאטוס</h2>
      <table style="width:100%;border-collapse:collapse;margin-bottom:24px;font-size:14px;">
        <tr><th style="${TH}">סטאטוס</th><th style="${TH};text-align:center">כמות</th><th style="${TH};text-align:center">אחוז</th></tr>
